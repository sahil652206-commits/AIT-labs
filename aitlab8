# Practical No. 08: Bayes' Theorem

def bayes_theorem(prior_h, likelihood_e_given_h,
                  likelihood_e_given_not_h):

    # Calculate total probability of evidence
    p_e = (likelihood_e_given_h * prior_h) + (
        likelihood_e_given_not_h * (1 - prior_h)
    )

    # Apply Bayes' Theorem
    posterior = (likelihood_e_given_h * prior_h) / p_e

    return posterior, p_e


def display_result(hypothesis, prior, likelihood_yes,
                   likelihood_no, posterior):

    print("\n" + "=" * 60)
    print("Bayes Theorem Calculation:", hypothesis)
    print("=" * 60)

    print(f"Prior Probability P(H): {prior:.4f}")
    print(f"Likelihood P(E|H): {likelihood_yes:.4f}")
    print(f"Likelihood P(E|not H): {likelihood_no:.4f}")
    print(f"Prior Probability P(not H): {1-prior:.4f}")

    print("-" * 60)
    print(f"Posterior Probability P(H|E): {posterior:.4f}")
    print(f"Confidence Level: {posterior * 100:.2f}%")
    print("=" * 60)


# Example 1: Medical Diagnosis
print("\nEXAMPLE 1: Medical Diagnosis")

hypothesis_1 = "Patient has the disease"
prior_1 = 0.01
sensitivity = 0.95
specificity = 0.90

false_positive_rate = 1 - specificity

posterior_1, p_evidence_1 = bayes_theorem(
    prior_1, sensitivity, false_positive_rate
)

display_result(
    hypothesis_1, prior_1, sensitivity,
    false_positive_rate, posterior_1
)

print("Interpretation:")
print("Probability of having disease:",
      f"{posterior_1 * 100:.2f}%")


